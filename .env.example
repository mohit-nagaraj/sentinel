# Default builds and tests do not require provider credentials. Values below are
# server-only and must never be exposed through NEXT_PUBLIC_ or browser bundles.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Paid compatibility probe; maximum is intentionally capped by validation.
RUN_AZURE_OPENAI_COMPATIBILITY=
AZURE_OPENAI_COMPATIBILITY_MAX_TOKENS=256

# Supabase operational database and private S3-compatible Storage.
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=sentinel-artifacts

# Opt-in integration tests. SENTINEL_TEST_DATABASE_URL must use a disposable
# loopback database and can never reuse SUPABASE_DB_URL.
RUN_SUPABASE_INTEGRATION_TESTS=
RUN_SUPABASE_STORAGE_TESTS=
RUN_SUPABASE_VAULT_TESTS=
SENTINEL_TEST_DATABASE_URL=

# Neo4j Aura active knowledge graph. These settings are server-only.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Aura graph tests also require a generated sentinel-test-<hex> namespace.
RUN_NEO4J_INTEGRATION_TESTS=
SENTINEL_NEO4J_TEST_PREFIX=
