# Default builds and tests do not require provider credentials. Values below are
# server-only and must never be exposed through NEXT_PUBLIC_ or browser bundles.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Paid compatibility probe; maximum is intentionally capped by validation.
RUN_AZURE_OPENAI_COMPATIBILITY=
AZURE_OPENAI_COMPATIBILITY_MAX_TOKENS=256

# Supabase operational database and private S3-compatible Storage.
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Prefer an asymmetric private JWK matching the Supabase signing key. The
# legacy JWT secret is supported for local Supabase development only.
SUPABASE_REALTIME_SIGNING_JWK=
SUPABASE_JWT_SECRET=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=sentinel-artifacts

# Server-derived take-home operator identity for owner-scoped control-plane data.
SENTINEL_OPERATOR_ID=
SENTINEL_OPERATOR_TOKEN=

# Durable worker identity and a server module that exports createRunGraphs.
SENTINEL_WORKER_ID=
SENTINEL_WORKER_GRAPH_MODULE=
SENTINEL_WORKER_HEALTH_URL=
SENTINEL_MODEL_HEALTH_URL=
SENTINEL_BROWSER_HEALTH_URL=
SENTINEL_GITHUB_HEALTH_URL=
SENTINEL_WORKER_HEALTH_HOST=127.0.0.1
SENTINEL_WORKER_HEALTH_PORT=8788

# Opt-in integration tests. SENTINEL_TEST_DATABASE_URL must use a disposable
# loopback database and can never reuse SUPABASE_DB_URL.
RUN_SUPABASE_INTEGRATION_TESTS=
RUN_SUPABASE_STORAGE_TESTS=
RUN_SUPABASE_VAULT_TESTS=
SENTINEL_TEST_DATABASE_URL=

# Neo4j Aura active knowledge graph. These settings are server-only.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Aura graph tests also require a generated sentinel-test-<hex> namespace.
RUN_NEO4J_INTEGRATION_TESTS=
SENTINEL_NEO4J_TEST_PREFIX=

# Opt-in public read-only source smoke tests. GITHUB_TOKEN is optional and only
# raises the anonymous rate limit; no write scope is ever used.
GITHUB_TOKEN=
RUN_GITHUB_CHECKOUT_SMOKE=
RUN_TYPESCRIPT_INDEX_SMOKE=

# GitHub App for SNT-026 PR webhooks and check runs. Server-only. Webhook
# secret must be at least 32 characters. SENTINEL_PUBLIC_BASE_URL is the
# canonical HTTPS origin used in check details links, not the webhook path.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
SENTINEL_PUBLIC_BASE_URL=

# Deterministic local browser tests only. Never enable in a deployed environment.
SENTINEL_CONTROL_PLANE_FIXTURE=
